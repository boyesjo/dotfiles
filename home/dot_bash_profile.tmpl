{{ if eq .chezmoi.os "linux" -}}
# ~/.bash_profile — managed by chezmoi (linux only)
#
# System modules/env are set by /etc/profile.d before this file runs and are
# inherited across the exec below, so we don't reproduce them here.

# Standard: load ~/.bashrc for login shells (keeps env for non-interactive logins)
[ -f ~/.bashrc ] && . ~/.bashrc

# Hand over to zsh only for a real person sitting at a terminal. Every other
# way a login shell gets started must stay on bash and must still run whatever
# it was asked to run:
#   $- has 'i'               interactive only; excludes slurm jobs, scp/sftp,
#                            `ssh host cmd`, `bash -lc cmd`
#   BASH_EXECUTION_STRING    set whenever bash got -c. `bash -lic '...'` is
#                            interactive *and* has a command, and the exec
#                            below would silently swallow it. VS Code
#                            Remote-SSH and other env probes invoke it that way
#   -t 0 -t 1                real tty both ends, not a pipe
#   NO_ZSH_EXEC              escape hatch for debugging the bash side
if [[ $- == *i* && -z $BASH_EXECUTION_STRING && -t 0 && -t 1 && -z $NO_ZSH_EXEC ]] &&
   command -v zsh >/dev/null 2>&1; then
  export SHELL="$(command -v zsh)"
  exec zsh -l
fi
{{ end -}}
