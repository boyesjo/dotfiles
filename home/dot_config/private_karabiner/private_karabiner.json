{
    "global": {
        "show_additional_menu_items": true,
        "show_in_menu_bar": false
    },
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "F5 opens the Screenshot toolbar",
                        "manipulators": [
                            {
                                "from": { "key_code": "f5" },
                                "to": [
                                    {
                                        "key_code": "5",
                                        "modifiers": ["left_command", "left_shift"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Caps Lock to Ctrl+Option (Escape if alone and short press)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "parameters": { "basic.to_if_alone_timeout_milliseconds": 200 },
                                "to": [
                                    {
                                        "key_code": "left_control",
                                        "modifiers": ["left_option"]
                                    }
                                ],
                                "to_if_alone": [{ "key_code": "escape" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Hyper+Space toggles Paneru Switcher's window panel",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "spacebar",
                                    "modifiers": { "mandatory": ["control", "option"] }
                                },
                                "to": [{ "shell_command": "open -g paneru-switcher://toggle" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Caps Lock to hyper-light (esc if alone)",
                        "enabled": false,
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "key_code": "right_control",
                                        "modifiers": ["right_gui", "right_alt"]
                                    }
                                ],
                                "to_if_alone": [{ "key_code": "escape" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Right command + 8-9 => curly-brackets {}}",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "8",
                                    "modifiers": { "mandatory": ["right_command"] }
                                },
                                "to": [
                                    {
                                        "key_code": "8",
                                        "modifiers": ["left_option", "left_shift"]
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "9",
                                    "modifiers": { "mandatory": ["right_command"] }
                                },
                                "to": [
                                    {
                                        "key_code": "9",
                                        "modifiers": ["left_option", "left_shift"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Right command + 7 => Backslash(\\)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "7",
                                    "modifiers": { "mandatory": ["right_command"] }
                                },
                                "to": [
                                    {
                                        "key_code": "7",
                                        "modifiers": ["left_option", "left_shift"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "devices": [
                {
                    "identifiers": {
