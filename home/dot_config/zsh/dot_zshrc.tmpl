# # Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi
# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f $ZDOTDIR/.p10k.zsh ]] || source $ZDOTDIR/.p10k.zsh

# Personal completion scripts go here:
#   slam completion zsh          > ~/.config/zsh/completions/_slam
#   rustup completions zsh       > ~/.config/zsh/completions/_rustup
#   rustup completions zsh cargo > ~/.config/zsh/completions/_cargo
# Not wherever `${fpath[1]}` happens to point mid-session -- that's plugin load
# order dependent, and can land inside an antidote plugin's own directory,
# which then gets wiped on the next update.
mkdir -p ~/.config/zsh/completions
fpath=(~/.config/zsh/completions $fpath)

# Plugins call compdef as they load; queue those calls for the one compinit
# after `antidote load`, which needs every plugin's fpath in place first.
typeset -ga _compdef_queue
compdef() { _compdef_queue+=("${(j: :)${(@q)@}}") }

# Preferred editor for local and remote sessions
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='nano'
else
  export EDITOR='code --wait --disable-workspace-trust'
fi

path+=$HOME/bin
path+=$HOME/.local/bin


{{ if lookPath "bat" -}}
alias cat="bat --theme=ansi"
{{ end -}}


{{ if lookPath "claude" -}}
alias claude-work="CLAUDE_CONFIG_DIR=~/.claude-work claude"
{{ end -}}


{{ if lookPath "brew" -}}
# automatically set homebrew to arm/x86
[[ $(arch) = "arm64" ]] &&
    eval "$(/opt/homebrew/bin/brew shellenv)" ||
    eval "$(/usr/local/Homebrew/bin/brew shellenv)"

# export HOMEBREW=/opt/homebrew
# Add zsh completion scripts installed via Homebrew
# fpath=("$HOMEBREW/share/zsh/site-functions" $fpath)
# eval "$(/opt/homebrew/bin/brew shellenv)"
fpath=(${commands[brew]:h:h}/share/zsh/site-functions $fpath)

export HOMEBREW_NO_EMOJI=1
{{ end -}}

## FZF
export FZF_PATH="$HOME/.config/fzf"


source ${ZDOTDIR:-~}/.antidote/antidote.zsh
antidote load
unfunction compdef
autoload -Uz compinit && compinit
for _c in $_compdef_queue; do eval "compdef $_c"; done
unset _c _compdef_queue

# Slurm: zsh-native flag completion (parses each command's --help).
# Slurm's own slurm_completion.sh refuses to run outside bash, so we don't use it.
if command -v sbatch >/dev/null 2>&1; then
  compdef _gnu_generic sbatch srun salloc squeue scancel sinfo scontrol \
                       sacct sacctmgr sstat sbcast sattach sprio sshare sdiag
fi

{{ if lookPath "eza" -}}
# EZA
alias ls="eza"
alias l="eza -l --git"
alias lh="eza -A"
alias ll='eza -lA --git'
alias lt="eza -T --git"
alias lt2="eza -T --git -L 2"
alias lt3="eza -T --git -L 3"
alias lt4="eza -T --git -L 4"
{{ else -}}
# LS
alias ls='ls -G'
alias l='ls -lh'
alias lh="ls -A"
alias ll='ls -lAh'
alias lt="tree --gitignore"
alias lt2="tree --gitignore -L 2"
alias lt3="tree --gitignore -L 3"
alias lt4="tree --gitignore -L 4"
{{ end -}}

{{ if lookPath "chezmoi" -}}
# Dotfiles drift. `dotfiles-drift` lists what chezmoi and the Brewfile disagree
# on and caches the counts for the dotfiles_drift segment in .p10k.zsh.
# -q skips the listing; -c rechecks chezmoi only and keeps the cached brew counts.
# Every new shell and every chezmoi command recheck chezmoi in the background;
# brew is rechecked once the cache is a day old.
dotfiles-drift() {
  local cache=${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles-drift
  local -a cz readd apply missing extra old
  cz=(${(f)"$(command chezmoi status 2>/dev/null)"})
  # chezmoi status column 1: the file changed since chezmoi last wrote it (re-add);
  # column 2: applying would change it (apply).
  readd=(${(M)cz:#[^ ]?*}) apply=(${(M)cz:#?[^ ]*})
  [[ -r $cache ]] && old=(${=$(<$cache)})
  local nmissing=${old[3]:-0} nextra=${old[4]:-0}
  if [[ $* != *-c* ]] && (( $+commands[brew] )); then
    local brewfile="$(command chezmoi source-path)/Brewfile"
    missing=(${(f)"$(command brew bundle check --no-upgrade --verbose --file=$brewfile 2>&1 |
      sed -n 's/^→ \(.*\) needs to be installed\.$/\1/p')"})
    extra=(${(f)"$(command brew bundle cleanup --file=$brewfile 2>/dev/null |
      awk '/^Would `brew cleanup`/{exit} /^Would|^Run/{next} {print}')"})
    nmissing=$#missing nextra=$#extra
  fi
  mkdir -p ${cache:h}
  print -r -- "$#readd $#apply $nmissing $nextra" >| $cache.$$ && mv -f $cache.$$ $cache
  [[ $* == *-q* ]] && return
  (( $#readd )) && print -rl -- "!  edited here, chezmoi re-add:" "  "${^readd#???}
  (( $#apply )) && print -rl -- "⇣  source is ahead, chezmoi apply:" "  "${^apply#???}
  [[ $* == *-c* ]] && return
  (( $#missing )) && print -rl -- "+  in the Brewfile, not installed, brew bundle:" "  "$^missing
  (( $#extra )) && print -rl -- "?  installed, not in the Brewfile, brew bundle dump:" "  "$^extra
  (( $#cz + $#missing + $#extra )) || print "No drift."
}
() {
  local cache=${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles-drift
  local -a fresh=($cache(N.mh-24))
  if (( $#fresh )); then
    dotfiles-drift -q -c &>/dev/null &!
  else
    # Touch first so shells opened meanwhile don't start their own brew check.
    mkdir -p ${cache:h} && touch $cache
    dotfiles-drift -q &>/dev/null &!
  fi
}
chezmoi() {
  command chezmoi "$@"
  local rc=$?
  dotfiles-drift -q -c &>/dev/null &!
  return rc
}
# Keep the Brewfile in the chezmoi source current: after brew changes what is
# installed, redump it in the background and refresh the drift cache.
brew() {
  command brew "$@" || return
  case $1 in
    install|reinstall|uninstall|remove|rm|tap|untap|autoremove)
      ( command brew bundle dump --no-vscode --no-cargo --force \
          --file="$(chezmoi source-path)/Brewfile" && dotfiles-drift -q ) &>/dev/null &! ;;
  esac
}
{{ end -}}

# disable sort when completing `git checkout`
zstyle ':completion:*:git-checkout:*' sort false
# keep slam completions in the order the binary returns (values before flags)
zstyle ':completion:*:slam:*' sort false
zstyle ':fzf-tab:complete:slam:*' fzf-flags --no-sort
# set descriptions format to enable group support
zstyle ':completion:*:descriptions' format '[%d]'
# set list-colors to enable filename colorizing
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
# preview directory's content with eza when completing cd
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'
# preview files and directories for every other command too; the cd style
# above wins for cd because it is more specific
zstyle ':fzf-tab:complete:*:*' fzf-preview \
  '[[ -d $realpath ]] && eza -1 --color=always -- $realpath ||
   { [[ -f $realpath ]] && bat --color=always --style=plain --line-range=:200 -- $realpath }'
# switch group using `,` and `.`
zstyle ':fzf-tab:*' switch-group ',' '.'
