{{ if eq .chezmoi.os "darwin" -}}
#!/bin/sh
# Point iTerm at the settings folder chezmoi manages; it reads it at launch.
defaults write com.googlecode.iterm2 PrefsCustomFolder -string {{ joinPath .chezmoi.homeDir ".config/iterm2/settings" | quote }}
defaults write com.googlecode.iterm2 LoadPrefsFromCustomFolder -bool true
{{ end -}}
