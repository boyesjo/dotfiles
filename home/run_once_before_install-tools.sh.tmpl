{{ if eq .chezmoi.os "linux" -}}
#!/bin/sh
# Install user-local CLI tools (no root) into ~/.local/bin, which is already
# on $PATH via .config/zsh/.zshrc. Runs before dotfiles are applied so the
# lookPath guards in .zsh_plugins.txt / .zshrc resolve correctly.
# Idempotent: skips anything already installed.
set -eu

BIN="$HOME/.local/bin"
mkdir -p "$BIN"

case "$(uname -m)" in
  x86_64|amd64)
    EZA_TARGET=x86_64-unknown-linux-musl
    FF_TARGET=linux-amd64-polyfilled
    SLURMER_TARGET=linux-x86_64
    ;;
  aarch64|arm64)
    EZA_TARGET=aarch64-unknown-linux-gnu
    FF_TARGET=linux-aarch64-polyfilled
    SLURMER_TARGET=
    ;;
  *)
    echo "install-tools: unknown arch $(uname -m), nothing to do" >&2
    exit 0
    ;;
esac

# Fetch a tarball and install the binary named $1 out of it, wherever in the
# archive it sits. Never aborts the run: one dead release URL should not stop
# the remaining tools from installing.
install_tarball() {
  name="$1"
  url="$2"

  if command -v "$name" >/dev/null 2>&1 || [ -x "$BIN/$name" ]; then
    return 0
  fi
  echo "Installing $name -> $BIN"

  tmp="$(mktemp -d)"
  # Download to a file rather than piping into tar. In a pipeline only tar's
  # status is seen, so a 404 from curl reaches tar as an empty stream, which
  # GNU tar accepts silently, and the failure only surfaces later as a
  # confusing "cannot stat" from the install step.
  if ! curl -fsSL "$url" -o "$tmp/dl.tar.gz"; then
    echo "  download failed: $url" >&2
    rm -rf "$tmp"
    return 0
  fi
  tar xzf "$tmp/dl.tar.gz" -C "$tmp"

  # Release layouts change between versions (fastfetch moved the binary under
  # a versioned top-level directory), so search rather than hardcode a path.
  src="$(find "$tmp" -type f -name "$name" -perm -u+x -print 2>/dev/null | head -n 1)"
  if [ -z "$src" ]; then
    echo "  no executable named $name inside $url" >&2
    rm -rf "$tmp"
    return 0
  fi

  mv -f "$src" "$BIN/$name"
  chmod +x "$BIN/$name"
  rm -rf "$tmp"
}

install_tarball eza \
  "https://github.com/eza-community/eza/releases/latest/download/eza_${EZA_TARGET}.tar.gz"

install_tarball fastfetch \
  "https://github.com/fastfetch-cli/fastfetch/releases/latest/download/fastfetch-${FF_TARGET}.tar.gz"

# slurmer (SLURM job TUI). Pinned: the asset name embeds the version.
if command -v squeue >/dev/null 2>&1 && [ -n "$SLURMER_TARGET" ]; then
  install_tarball slurmer \
    "https://github.com/wjwei-handsome/Slurmer/releases/download/v0.1.2/slurmer-v0.1.2-${SLURMER_TARGET}.tar.gz"
fi

# --- fzf (prebuilt static binary; --bin touches no shell configs) ---
if ! command -v fzf >/dev/null 2>&1 && [ ! -x "$BIN/fzf" ]; then
  echo "Installing fzf -> $BIN"
  [ -d "$HOME/.fzf" ] || git clone --depth 1 https://github.com/junegunn/fzf "$HOME/.fzf"
  "$HOME/.fzf/install" --bin
  ln -sf "$HOME/.fzf/bin/fzf" "$BIN/fzf"
fi

# --- tree (no upstream binary releases; it is a single small C file) ---
if ! command -v tree >/dev/null 2>&1 && [ ! -x "$BIN/tree" ]; then
  echo "Installing tree -> $BIN"
  tmp="$(mktemp -d)"
  if git clone -q --depth 1 https://github.com/Old-Man-Programmer/tree "$tmp/src" &&
     make -C "$tmp/src" >/dev/null 2>&1; then
    mv -f "$tmp/src/tree" "$BIN/tree"
    chmod +x "$BIN/tree"
  else
    echo "  tree build failed (needs git, make and a C compiler)" >&2
  fi
  rm -rf "$tmp"
fi
{{ end -}}
